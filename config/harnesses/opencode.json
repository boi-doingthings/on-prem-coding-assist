{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "campus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Campus LLM (NVIDIA Dynamo)",
      "options": { "baseURL": "@@BASE_URL@@", "apiKey": "{env:CAMPUS_LLM_KEY}" },
      "models": {
        "@@MODEL@@": { "name": "@@MODEL@@", "limit": { "context": @@CONTEXT@@, "output": @@MAX_OUTPUT@@ } }
      }
    }
  },
  "model": "campus/@@MODEL@@",
  "small_model": "campus/@@MODEL@@",
  "enabled_providers": ["campus"],
  "share": "disabled",
  "autoupdate": false
}
