# openai/gpt-oss-20b — 21B MoE / 3.6B active, native MXFP4 (~14 GB), Apache-2.0.
# Fits every GPU tier including A100-40GB and L40S. On Ampere vLLM uses Marlin
# MXFP4 MoE + Triton attention automatically. Vendor: SWE-bench Verified 60.7
# (high reasoning), AIME25 91.7 — good teaching/chat model, modest agent.
# Validated on 1x B300 (vllm-runtime 1.3.0): harmony tool calls OK, clean to
# c128 (16.1K out tok/s/GPU at 188 tok/s/user).
DYNAMO_MODEL=openai/gpt-oss-20b
DYNAMO_SERVED_MODEL=openai/gpt-oss-20b
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=harmony
DYNAMO_REASONING_PARSER=gpt_oss
DYNAMO_MAX_MODEL_LEN=131072
DYNAMO_EXTRA_ARGS="--gpu-memory-utilization 0.90 --max-num-seqs 128"
DYNAMO_DOWNLOAD_ARGS="--exclude original/* --exclude metal/*"
EDU_MIN_GPU_MEM_GB=24
