# openai/gpt-oss-120b — 117B MoE / 5.1B active, native MXFP4 (~61 GB), Apache-2.0.
# One 80 GB GPU (A100-80 via Marlin, H100) or larger. Flags follow
# upstream/dynamo/recipes/gpt-oss-120b (vLLM agentic variants, minus EAGLE3).
# Hopper/Blackwell: add --kv-cache-dtype fp8 to DYNAMO_EXTRA_ARGS.
DYNAMO_MODEL=openai/gpt-oss-120b
DYNAMO_SERVED_MODEL=openai/gpt-oss-120b
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=harmony
DYNAMO_REASONING_PARSER=gpt_oss
DYNAMO_MAX_MODEL_LEN=131072
DYNAMO_EXTRA_ARGS="--gpu-memory-utilization 0.90 --max-num-seqs 128 --max-num-batched-tokens 32768 --async-scheduling"
DYNAMO_DOWNLOAD_ARGS="--exclude original/* --exclude metal/*"
EDU_MIN_GPU_MEM_GB=80
