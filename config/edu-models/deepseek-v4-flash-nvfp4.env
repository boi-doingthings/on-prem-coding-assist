# nvidia/DeepSeek-V4-Flash-NVFP4 — 284B MoE / 13B active, MIT, 1M context.
# Vendor: SWE-bench Verified 79.0, Terminal-Bench 2.0 56.9, LCB 91.6.
# Upstream recipe deepseek-v4/deepseek-v4-flash vllm/agg-b200-agentic: TP4 on
# 4x B200 → 362 tok/s/GPU at 50 tok/s/user on a 64K/400/90%-reuse agent trace.
# Advanced: first launch can take ~60 min; H200 uses the public FP4+FP8
# checkpoint with DP4+EP and --moe-backend marlin (see recipe).
DYNAMO_RUNTIME_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.3.0
DYNAMO_MODEL=nvidia/DeepSeek-V4-Flash-NVFP4
DYNAMO_SERVED_MODEL=deepseek-ai/DeepSeek-V4-Flash
DYNAMO_BACKEND=vllm
DYNAMO_TP=4
DYNAMO_KV_BLOCK_SIZE=256
DYNAMO_TOOL_PARSER=deepseek_v4
DYNAMO_REASONING_PARSER=deepseek_v4
DYNAMO_MAX_MODEL_LEN=1048576
DYNAMO_EXTRA_ARGS="--tokenizer-mode deepseek_v4 --kv-cache-dtype fp8 --moe-backend flashinfer_trtllm --max-num-seqs 64 --max-num-batched-tokens 16384 --gpu-memory-utilization 0.92 --no-scheduler-reserve-full-isl"
EDU_MIN_GPU_MEM_GB=180
