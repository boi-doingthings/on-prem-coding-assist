# nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B — hybrid Mamba/attention MoE,
# 3B active, OpenMDW-1.1 license, open training data/recipes (NeMo RL) → the
# natural base for campus post-training. Vendor: SWE-bench Verified 51.6.
# Upstream recipe: NVFP4 on H100/H200, BF16 on B200/GB200, dev image below.
# Recipe also uses MTP/DFlash/DSpark speculative decoding — omitted here.
DYNAMO_RUNTIME_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.5.0-nemotron-3.5-lightning-dev.1
DYNAMO_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
DYNAMO_SERVED_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=nemotron_nano
DYNAMO_REASONING_PARSER=nemotron_nano
DYNAMO_EXTRA_ARGS="--reasoning-parser nemotron_v3 --max-num-seqs 512 --async-scheduling --mamba-backend flashinfer --mamba-ssm-cache-dtype float16"
EDU_MIN_GPU_MEM_GB=80
