# Qwen/Qwen3.6-35B-A3B-FP8 — 36B hybrid DeltaNet MoE / 3B active, Apache-2.0.
# ~36 GB FP8 weights; small KV (hybrid attention) → many concurrent sessions.
# Vendor: SWE-bench Verified 73.4, Terminal-Bench 2.0 51.5, LCB v6 80.4.
# Flags follow upstream/dynamo/recipes/qwen3.6-35b (vLLM, 1x H100, 32K ctx).
# Validated on 1x B300 with vllm-runtime 1.5.0: tool calls OK, clean to c128
# (8.9K out tok/s/GPU). Wedged at c8 on 1.3.0 — require image >= 1.5.0.
# Raise DYNAMO_MAX_MODEL_LEN to 131072+ on H200/B200/B300 for agent use.
DYNAMO_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
DYNAMO_SERVED_MODEL=Qwen/Qwen3.6-35B-A3B
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=qwen3_coder
DYNAMO_REASONING_PARSER=qwen3
DYNAMO_MAX_MODEL_LEN=32768
DYNAMO_EXTRA_ARGS="--gpu-memory-utilization 0.85 --mamba-ssm-cache-dtype float16"
EDU_MIN_GPU_MEM_GB=48
