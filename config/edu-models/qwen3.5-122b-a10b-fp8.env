# Qwen/Qwen3.5-122B-A10B-FP8 — Hopper version (~118 GB FP8).
# Upstream recipe qwen3.5-122b/fp8/vllm/agg-h200-agentic: 2 replicas x TP2 on
# 4x H200, 720 tok/s/GPU at 53 tok/s/user (with MTP, synthetic acceptance).
# MTP omitted here (crashes with prefix caching under long concurrent load).
# Cold load of the FP8 weights took ~28 min upstream: stage on fast storage.
DYNAMO_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
DYNAMO_SERVED_MODEL=Qwen/Qwen3.5-122B-A10B
DYNAMO_BACKEND=vllm
DYNAMO_TP=2
DYNAMO_TOOL_PARSER=qwen3_coder
DYNAMO_REASONING_PARSER=qwen3
DYNAMO_MAX_MODEL_LEN=262144
DYNAMO_EXTRA_ARGS="--max-num-seqs 128 --max-num-batched-tokens 16384 --gpu-memory-utilization 0.95 --mamba-ssm-cache-dtype float16"
EDU_MIN_GPU_MEM_GB=141
