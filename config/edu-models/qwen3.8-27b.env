# Qwen/Qwen3.8-27B — 27.8B dense hybrid DeltaNet, Apache-2.0 (Aug 2026).
# Strongest vendor-reported coding scores per GPU in Sep 2026: Terminal-Bench
# 2.1 73.0, SWE-bench Pro 61.7, LCB v6 90.3. BF16 ~56 GB (1x 80 GB);
# FP8 checkpoint Qwen/Qwen3.8-27B-FP8 for 48 GB / Hopper; NVFP4
# nvidia/Qwen3.8-27B-NVFP4 for Blackwell.
# TEMPLATE: no Dynamo recipe exists yet. Same architecture family as
# Qwen3.5/3.6 (qwen3_coder + qwen3 parsers); validate before class use.
DYNAMO_MODEL=Qwen/Qwen3.8-27B
DYNAMO_SERVED_MODEL=Qwen/Qwen3.8-27B
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=qwen3_coder
DYNAMO_REASONING_PARSER=qwen3
DYNAMO_MAX_MODEL_LEN=131072
DYNAMO_EXTRA_ARGS="--gpu-memory-utilization 0.90 --mamba-ssm-cache-dtype float16"
EDU_MIN_GPU_MEM_GB=80
