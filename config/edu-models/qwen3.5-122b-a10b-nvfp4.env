# nvidia/Qwen3.5-122B-A10B-NVFP4 — 122B hybrid MoE / 10B active, Apache-2.0.
# This lab's production model: 1 GPU per replica on B200/B300 (Blackwell only).
# Validated on 1x B300 with vllm-runtime 1.5.0 (2026-09-26): clean to c32,
# 2,005 out tok/s/GPU at 104 tok/s/user. With 1.3.0 the engine wedged above ~7
# concurrent prefills (results/dynamo-1.5-hybrid-models-2026-09-26.md) —
# do not serve hybrid Qwen models on images older than 1.5.0.
# Upstream B200 agentic recipe: 1173 tok/s/GPU at 52 tok/s/user (2x TP1 agg).
DYNAMO_MODEL=nvidia/Qwen3.5-122B-A10B-NVFP4
DYNAMO_SERVED_MODEL=Qwen/Qwen3.5-122B-A10B
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=qwen3_coder
DYNAMO_REASONING_PARSER=qwen3
DYNAMO_EXTRA_ARGS="--quantization modelopt_fp4 --kv-cache-dtype fp8 --moe-backend flashinfer_trtllm --mamba-ssm-cache-dtype float16 --no-disable-hybrid-kv-cache-manager --max-num-seqs 32 --max-num-batched-tokens 16384 --gpu-memory-utilization 0.9"
VLLM_SSM_CONV_STATE_LAYOUT=DS
VLLM_ALLOW_CHUNKED_LOCAL_ATTN_WITH_HYBRID_KV_CACHE=1
EDU_MIN_GPU_MEM_GB=180
