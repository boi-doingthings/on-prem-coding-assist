# Canary: validates the whole stack in minutes on any NVIDIA GPU (>= 8 GB).
# Not a useful coding model; use it for Lab 1 and after every upgrade.
# Verified 2026-09-26 on 2 x B300 with vllm-runtime:1.3.0 (tool calls OK,
# clean sweep to concurrency 128).
DYNAMO_MODEL=Qwen/Qwen3-0.6B
DYNAMO_SERVED_MODEL=Qwen/Qwen3-0.6B
DYNAMO_BACKEND=vllm
DYNAMO_TP=1
DYNAMO_TOOL_PARSER=hermes
DYNAMO_REASONING_PARSER=qwen3
DYNAMO_MAX_MODEL_LEN=32768
EDU_MIN_GPU_MEM_GB=8
