# nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8 — hybrid Mamba/attention MoE,
# 12B active, NVIDIA Nemotron Open Model License, open data. 4x H100/H200 TP4.
# Vendor: SWE-bench Verified 60.5 (OpenHands). Flags + caveats from
# upstream/dynamo/recipes/nemotron-3-super-fp8: --mamba-cache-mode align avoids
# NaN/garbage with prefix caching (vllm#34865); on Blackwell also add
# --attention-backend FLASH_ATTN. KV events for hybrid Mamba are not reliable
# yet: use round-robin (or approximate) routing.
DYNAMO_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
DYNAMO_SERVED_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
DYNAMO_BACKEND=vllm
DYNAMO_TP=4
DYNAMO_ROUTER_MODE=round-robin
DYNAMO_TOOL_PARSER=nemotron_nano
DYNAMO_REASONING_PARSER=nemotron_nano
DYNAMO_EXTRA_ARGS="--mamba-cache-mode align"
VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm
EDU_MIN_GPU_MEM_GB=80
