# Copy to gateway.env (ignored by git) and fill in. Generate secrets with:
#   openssl rand -hex 32
LITELLM_IMAGE=
OPEN_WEBUI_IMAGE=
LITELLM_MASTER_KEY=
POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
OPEN_WEBUI_LITELLM_KEY=
DYNAMO_BASE_URL=http://<gpu-node>:8000/v1
DYNAMO_MAX_PARALLEL=6
# Optional SSO
ENABLE_OAUTH_SIGNUP=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=
# Optional opt-in tracing
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
